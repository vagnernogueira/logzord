# Estágio 1: Build da aplicação Vue.js/Vite
FROM docker.io/node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
ARG GITHUB_TOKEN
RUN test -n "$GITHUB_TOKEN" \
  && printf '@vagnernogueira:registry=https://npm.pkg.github.com\n//npm.pkg.github.com/:_authToken=%s\n' "$GITHUB_TOKEN" > .npmrc \
  && npm install \
  && rm .npmrc

COPY . .
RUN npm run build

# Estágio 2: Servidor Web Leve (Nginx) para os arquivos estáticos
FROM docker.io/nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]